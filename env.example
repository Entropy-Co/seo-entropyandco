# ============================================================
# Entropy & Co. SEO engine: environment variables
# Copy to .env (never commit it). Only the LLM key for your chosen provider is required.
# ============================================================

# --- LLM provider -------------------------------------------------
# anthropic | openai. Each tier can be pinned to the other provider, e.g. a
# judge on a different model family so the panel never grades its own writer.
LLM_PROVIDER=anthropic
# LLM_PROVIDER_JUDGE=openai

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-5-5
ANTHROPIC_MODEL_HEAVY=claude-opus-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_JUDGE=claude-sonnet-5-5
ANTHROPIC_REFUSAL_FALLBACKS=true

OPENAI_API_KEY=
# Required when any tier uses OpenAI: an exact model id your account can use.
OPENAI_MODEL=
# OPENAI_MODEL_HEAVY=
# OPENAI_MODEL_JUDGE=

# Depth per tier (low | medium | high | xhigh | max). Claude 5.x ignores temperature; effort is the control.
LLM_EFFORT_DEFAULT=medium
LLM_EFFORT_HEAVY=high
LLM_EFFORT_FAST=low
LLM_EFFORT_JUDGE=medium
# Optional price overrides for the cost cap: {"model-substring": [input_usd_per_m, output_usd_per_m]}
LLM_PRICE_OVERRIDES=

# --- Research (all optional) ---------------------------------------
SERPAPI_KEY=
SERPAPI_MARKET=us
GOOGLE_SERVICE_ACCOUNT_JSON=          # raw or base64 service-account JSON with GSC read access
GSC_SITE_URL=sc-domain:entropyand.co

# --- Framer CMS ------------------------------------------------------
# Project URL from the Framer editor (https://framer.com/projects/<name>--<id>), and a
# project API key from Site Settings > General. Run `entropyseo framer-check` after setting.
FRAMER_PROJECT_URL=
FRAMER_API_KEY=
# draft: CMS item saved as draft (nothing goes live). preview: publish a preview deployment.
# live: preview, then promote that exact deployment to the custom domain.
FRAMER_PUBLISH_MODE=draft

# --- Site --------------------------------------------------------------
SITE_URL=https://entropyand.co
BLOG_PATH_PREFIX=/blog/
BLOG_AUTHOR=Entropy & Co.

# --- Safety switches ---------------------------------------------------
DRY_RUN=true                 # flip to false only after a reviewed end-to-end run
SEO_PUBLISH_ENABLED=false    # gates every Framer write from the scheduled run
COST_CAP_PER_RUN_USD=10
VELOCITY_CAP_PER_DAY=1
VELOCITY_CAP_PER_WEEK=3

# --- Storage -------------------------------------------------------------
STATE_DIR=state              # calendar, ledger, corpus cache (mount a volume here in production)
DRAFTS_DIR=drafts
LOG_LEVEL=INFO
